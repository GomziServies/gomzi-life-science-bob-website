# Copy to .env.local for local development. Every value has a working default, so this file is only needed to point at another server.

# Where the dev server forwards /api, /media, /ws and /crm (fg-api, which holds the editor backend and the shop's order calls).
VITE_API_PROXY=http://localhost:80
# Optional: send the shop's order calls (/crm) to a different server than the API.
# VITE_CRM_PROXY=http://localhost:80

# Production builds call the same origin (/api, /media, /crm). Put a reverse proxy in front that sends those paths to fg-api,
# or build with the full addresses:
# VITE_EDITOR_API=https://api.example.com/api/v1
# VITE_EDITOR_MEDIA=https://api.example.com/media
# VITE_CRM_API=https://api.example.com/crm/public/v1
# VITE_EDITOR_URL=https://labels.example.com
# VITE_WHATSAPP=918320077993
# Optional: read label pictures straight from the CDN once it sends CORS headers (default: through the dev server's /aws-files).
# VITE_AWS_FILES_URL=https://files.fggroup.in
